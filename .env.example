# ============================================================
# ShoeScout — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database (TimescaleDB + pgvector) ---
DATABASE_URL=postgresql://shoescout:changeme@localhost:5432/shoescout
POSTGRES_PASSWORD=changeme

# --- SerpApi (Google Shopping) ---
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_CACHE_TTL_SECONDS=600      # 10-minute response cache
SERPAPI_FIXTURE_MODE=false          # true = read from tests/fixtures/ (no quota burned)

# --- Ollama / Gemma (open-weight, runs locally) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b              # swap to gemma3:8b or gemma3:27b with this one line
OLLAMA_EMBED_MODEL=nomic-embed-text # open embedding model for pgvector similarity

# --- TabPFN micro-service (Python / FastAPI) ---
TABPFN_SERVICE_URL=http://localhost:8001

# --- API server ---
PORT=3000
NODE_ENV=development
RATE_LIMIT_RPM=30                   # requests per minute per IP

# --- Sanskar's default profile (also seeded into friend_profile table) ---
FRIEND_NAME=Sanskar
FRIEND_DEFAULT_BUDGET=10000         # INR
FRIEND_DEFAULT_SIZE=9               # UK size
FRIEND_USAGE_NOTES="Runs 5 km three times a week on roads. Prefers neutral cushioning. Tired of overpaying because prices differ across sites."
